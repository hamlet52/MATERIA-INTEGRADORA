    {
        "id": "7831073e9c82d333",
        "type": "function",
        "z": "9c64561949ef2c0f",
        "name": "function 3",
        "func": "// Recuperar de la memoria de Node-RED los arrays recibidos previamente\nlet datosUMA = flow.get('datosUMA') || [];\nlet datosTermostato = flow.get('datosTermostato') || [];\n\n// Actualizar la memoria según el topic del mensaje que acaba de llegar\nif (msg.topic === \"uma\") {\n    datosUMA = msg.payload; // Ya viene recortado en 7 elementos\n    flow.set('datosUMA', datosUMA);\n} else if (msg.topic === \"termostato\") {\n    datosTermostato = msg.payload; // Viene en 2 elementos\n    flow.set('datosTermostato', datosTermostato);\n}\n\n// Unir ambos arreglos en uno solo de 9 elementos (7 de UMA + 2 de Termostato)\nlet datosCombinados = datosUMA.concat(datosTermostato);\n\n// Enviar el array listo\nmsg.payload = datosCombinados;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1040,
        "y": 380,
        "wires": [
