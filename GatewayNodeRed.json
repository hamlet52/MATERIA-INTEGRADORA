    },
    {
        "id": "f3edc96e96c40d16",
        "type": "function",
        "z": "9c64561949ef2c0f",
        "name": "function 2",
        "func": "// Si ya viene como un arreglo de 2 elementos, solo tomamos los primeros 2 por seguridad\nif (Array.isArray(msg.payload)) {\n    msg.payload = msg.payload.slice(0, 2);\n}\n\n// Asignar identificador único\nmsg.topic = \"termostato\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
