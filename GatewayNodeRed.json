    {
        "id": "478c483b3e12f0b0",
        "type": "function",
        "z": "9c64561949ef2c0f",
        "name": "function 1",
        "func": "// Validar que payload sea un arreglo\nif (Array.isArray(msg.payload)) {\n    // Tomar solo desde el elemento 0 hasta el 6 (los primeros 7 elementos)\n    msg.payload = msg.payload.slice(0, 7);\n}\n\n// Asignar identificador único para después poder juntarlos\nmsg.topic = \"uma\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 480,
