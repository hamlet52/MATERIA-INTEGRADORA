        "type": "function",
        "z": "9c64561949ef2c0f",
        "name": "function 4",
        "func": "// El array de bytes viene en msg.payload\nconst array = msg.payload;\n\n// HR 9 está exactamente en las posiciones 18 y 19\nconst byteAlto = array[18]; // Lee el 11\nconst byteBajo = array[19]; // Lee el 79\n\n// Reconstruye el número entero (2895)\nmsg.payload = (byteAlto << 8) | byteBajo;\n\nreturn msg;\n",
        "outputs": 1,
