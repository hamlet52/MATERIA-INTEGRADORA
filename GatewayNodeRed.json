        "func": "// 1. Leer directamente las dos casillas de la memoria del flujo\nlet datoF1 = flow.get('valor_posicion_1'); \nlet arregloF12 = flow.get('valor_f12');    \n\n// 2. Validar que ambos datos existan en la memoria antes de operar\nif (datoF1 === undefined || !Array.isArray(arregloF12)) {\n    return null; \n}\n\n// 3. Extraer de forma individual los bytes del arreglo guardado\nlet b1 = arregloF12[0]; \nlet b2 = arregloF12[1]; \nlet b3 = arregloF12[2]; \n\n// 4. LÓGICA DE CONDICIÓN UNIFICADA\n// Evalúa si pasa el Caso 1 (datoF1 es 1 y todos los bytes son 0)\n// O si pasa el Caso 2 (datoF1 es 0 y al menos un byte es 1)\nif ((datoF1 === 1 && b1 === 0 && b2 === 0 && b3 === 0) || (datoF1 === 0 && (b1 === 1 || b2 === 1 || b3 === 1))) {\n    \n    // Si cualquiera de los dos casos es verdadero, asigna el número 1\n    msg.payload = 1; \n    return msg; // Pasa el número 1 al siguiente nodo (ej. el limit o switch)\n}\n\n// Si los datos no cumplen ninguna condición, detiene el flujo\nreturn msg;\n",
